# ═════════════════════════════════════════════════════════════════════
# FINOVA PRO - ENVIRONMENT CONFIGURATION FOR RENDER DEPLOYMENT
# ═════════════════════════════════════════════════════════════════════

# Server Port (Render automatically sets process.env.PORT)
PORT=5000

# Application Environment (development | production)
NODE_ENV=production

# JWT Authentication Secret Key
JWT_SECRET=finova_pro_jwt_secret_key_2026_render_prod

# MongoDB Connection String (MongoDB Atlas or Cloud Instance)
# Example: mongodb+srv://username:password@cluster0.mongodb.net/finovapro?retryWrites=true&w=majority
MONGODB_URI=
